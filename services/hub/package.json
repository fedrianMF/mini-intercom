{
  "name": "@mini-intercom/hub",
  "version": "0.1.0",
  "private": true,
  "description": "Interoperability hub: receives, validates, routes and traces electronic documents between member-country entities",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "0.10.9",
    "fastify": "5.12.7",
    "jose": "6.1.0",
    "pg": "8.16.3",
    "xmllint-wasm": "5.0.0"
  },
  "devDependencies": {
    "@types/amqplib": "0.10.7",
    "@types/node": "22.18.8",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
