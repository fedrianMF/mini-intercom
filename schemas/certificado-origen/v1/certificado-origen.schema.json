{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-intercom.dev/schemas/certificado-origen/v1",
  "title": "Certificado de Origen (demo)",
  "description": "Simplified certificate of origin used by mini-INTERCOM. Not an official CAN schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "numero",
    "fechaEmision",
    "normaOrigen",
    "exportador",
    "importador",
    "factura",
    "mercancias"
  ],
  "properties": {
    "numero": { "type": "string", "pattern": "^[A-Z]{2}-[0-9]{4}-[0-9]{6}$" },
    "fechaEmision": { "type": "string", "format": "date" },
    "normaOrigen": { "type": "string", "enum": ["Decision 416"] },
    "exportador": { "$ref": "#/$defs/operador" },
    "importador": { "$ref": "#/$defs/operador" },
    "factura": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numero", "fecha"],
      "properties": {
        "numero": { "type": "string", "minLength": 1, "maxLength": 40 },
        "fecha": { "type": "string", "format": "date" }
      }
    },
    "medioTransporte": { "type": "string", "enum": ["terrestre", "maritimo", "aereo", "fluvial", "multimodal"] },
    "mercancias": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "subpartidaNandina", "descripcion", "cantidad", "unidad", "valorFob", "criterioOrigen"],
        "properties": {
          "item": { "type": "integer", "minimum": 1 },
          "subpartidaNandina": { "type": "string", "pattern": "^[0-9]{8}$" },
          "descripcion": { "type": "string", "minLength": 3, "maxLength": 500 },
          "cantidad": { "type": "number", "exclusiveMinimum": 0 },
          "unidad": { "type": "string", "minLength": 1, "maxLength": 10 },
          "valorFob": { "type": "number", "minimum": 0 },
          "criterioOrigen": { "type": "string", "enum": ["a", "b", "c", "d", "e"] }
        }
      }
    },
    "observaciones": { "type": "string", "maxLength": 1000 }
  },
  "$defs": {
    "operador": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nombre", "identificacion", "pais"],
      "properties": {
        "nombre": { "type": "string", "minLength": 1, "maxLength": 200 },
        "identificacion": { "type": "string", "minLength": 1, "maxLength": 30 },
        "direccion": { "type": "string", "maxLength": 300 },
        "pais": { "type": "string", "enum": ["BO", "CO", "EC", "PE"] }
      }
    }
  }
}
